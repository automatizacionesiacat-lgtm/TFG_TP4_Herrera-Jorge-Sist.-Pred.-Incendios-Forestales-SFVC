# ---- APIs de datos ----
NASA_FIRMS_API_KEY=tu_clave
OPENWEATHER_API_KEY=tu_clave

# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=tu_clave
# VERIFICAR el identificador vigente en https://openrouter.ai/models (las variantes :free cambian o se retiran)
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# ---- Telegram: un chat por organismo (HU-04/HU-05) ----
TELEGRAM_BOT_TOKEN=tu_token
TELEGRAM_CHAT_ID_DEFENSA_CIVIL=id_chat_defensa_civil
TELEGRAM_CHAT_ID_BOMBEROS=id_chat_bomberos
TELEGRAM_CHAT_ID_ADMIN=id_chat_administrador

# ---- Email (Resend) ----
RESEND_API_KEY=tu_clave
# Con onboarding@resend.dev Resend solo entrega a TU propio correo. Para llegar a las autoridades
# hay que verificar un dominio en Resend y usar un remitente de ese dominio.
EMAIL_REMITENTE=onboarding@resend.dev
EMAIL_AUTORIDADES=autoridad1@ejemplo.com,autoridad2@ejemplo.com
EMAIL_DEFENSA_CIVIL=defensacivil@ejemplo.com
EMAIL_BOMBEROS=bomberos@ejemplo.com

# ---- Seguridad ----
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET=cambiar_por_un_valor_largo_y_aleatorio
# Generar con: python backup.py --generar-clave
BACKUP_KEY=
# Carpeta sincronizada con Google Drive para escritorio (opcional)
BACKUP_SYNC_DIR=

# ---- Opciones ----
# El TP4 asigna la revisión al autor (Product Owner): el informe queda en 'borrador' y se aprueba por Telegram antes de enviarse.
REVISION_MANUAL=true
